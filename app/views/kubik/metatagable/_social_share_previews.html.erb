<%# locals: meta — resolved OG/Twitter hash from the host app (see kubik_interface_elements doc) %>
<% if respond_to?(:render_kubik_social_share_previews) %>
  <%= render_kubik_social_share_previews(meta: meta) %>
<% else %>
