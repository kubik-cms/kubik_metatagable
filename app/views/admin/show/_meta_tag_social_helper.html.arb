social_table = proc do
  attributes_table_for resource.meta_tag do
    row :og_title
    row :og_description
    row :og_type
    row :og_image do
      og_upload = resource.meta_tag&.og_image_upload
      if og_upload&.image_url(:social_og).present?
        image_tag og_upload.image_url(:social_og)
      end
    end
    row :twitter_title
    row :twitter_description
    row :twitter_media do
      twitter_upload = resource.meta_tag&.twitter_image_upload
      if twitter_upload.present?
        derivative = KubikMetatagable::SocialMetaImages.derivative_for(platform: :twitter, meta_tag: resource.meta_tag)
        image_tag twitter_upload.image_url(derivative) if twitter_upload.image_url(derivative).present?
      end
    end
    row :twitter_card_type
  end
end

if local_assigns.fetch(:wrap_fieldset, true)
  div class: "kubik-admin-fieldset" do
    render partial: helpers.kubik_metatagable_fieldset_header_partial, locals: { title: "Social sharing" }
    div class: "kubik-admin-fieldset__body" do
      instance_eval(&social_table)
    end
  end
else
  instance_eval(&social_table)
end
