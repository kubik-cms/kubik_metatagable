meta_model = f.object.meta_tag || ::Kubik::MetaTag.new

div class: "kubik-admin-fieldset kubik-admin-fieldset--form" do
  render(
    partial: helpers.kubik_metatagable_fieldset_header_partial,
    locals: {
      title: "Social sharing",
      actions: helpers.kubik_metatagable_form_header_actions(f.object, "social")
    }
  )
  div class: "kubik-admin-fieldset__body kubik-admin-fieldset__body--inputs" do
    insert_tag Arbre::Rails::Forms::FieldsForProxy, f.form_builder, :meta_tag, meta_model do |mf|
      meta_ff = mf.form_builder
      insert_tag ActiveAdmin::Views::SemanticInputsProxy, meta_ff, name: "" do
        text_node meta_ff.input(:og_title, as: :string, label: "OG title")
        text_node meta_ff.input(:og_description, as: :text, label: "OG description")
        text_node meta_ff.input(:og_type, as: :string, label: "OG type", hint: "website, article")
        if Object.const_defined?("KubikMediaLibrary")
          text_node meta_ff.input(
            :og_image_upload,
            as: "kubik/single_media",
            association: ActiveModel::Naming.param_key(f.object),
            name: "meta_tag"
          )
        else
          text_node meta_ff.input(:og_image, as: :string, label: "OG image")
        end
        text_node meta_ff.input(:twitter_title, as: :string)
        text_node meta_ff.input(:twitter_description, as: :text)
        if Object.const_defined?("KubikMediaLibrary")
          text_node meta_ff.input(
            :twitter_image_upload,
            as: "kubik/single_media",
            label: "Twitter media location",
            association: ActiveModel::Naming.param_key(f.object),
            name: "meta_tag"
          )
        else
          text_node meta_ff.input(:twitter_media, as: :string)
        end
        text_node meta_ff.input(
          :twitter_card_type,
          as: :select,
          collection: ::Kubik::MetaTag::TWITTER_CARD_TYPES
        )
      end
    end
  end
end
