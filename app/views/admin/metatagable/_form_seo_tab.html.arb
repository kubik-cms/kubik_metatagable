meta_model = f.object.meta_tag || ::Kubik::MetaTag.new

div class: "kubik-admin-fieldset kubik-admin-fieldset--form" do
  render(
    partial: helpers.kubik_metatagable_fieldset_header_partial,
    locals: {
      title: "Search & sharing",
      actions: helpers.kubik_metatagable_form_header_actions(f.object, "seo")
    }
  )
  div class: "kubik-admin-fieldset__body kubik-admin-fieldset__body--inputs" do
    # Avoid f.inputs(for: :meta_tag): Formtastic concat's nested fieldsets onto the form buffer.
    insert_tag Arbre::Rails::Forms::FieldsForProxy, f.form_builder, :meta_tag, meta_model do |mf|
      meta_ff = mf.form_builder
      insert_tag ActiveAdmin::Views::SemanticInputsProxy, meta_ff, name: "" do
        text_node meta_ff.input(
          :title_tag,
          label: "Title tag",
          hint: "Browser tab and default search result title."
        )
        text_node meta_ff.input(
          :meta_description,
          as: :text,
          label: "Meta description",
          hint: "Plain-language summary for search results (keep under ~160 characters)."
        )
        text_node meta_ff.input(
          :canonical_url_override,
          label: "Canonical URL",
          hint: "Optional full URL if this page should canonicalise elsewhere. Leave blank to use the default page URL."
        )
        text_node meta_ff.input(
          :share_enabled,
          as: :boolean,
          label: "Show share button",
          hint: "When off, the copy-link share control is hidden on the public site.",
          wrapper_html: { class: "true_false" }
        )
        text_node meta_ff.input(
          :robots_noindex,
          as: :boolean,
          label: "Hide from search engines (noindex)",
          wrapper_html: { class: "true_false" }
        )
        text_node meta_ff.input(
          :robots_nofollow,
          as: :boolean,
          label: "Do not follow links on this page (nofollow)",
          wrapper_html: { class: "true_false" }
        )
        text_node meta_ff.input(
          :robots_noarchive,
          as: :boolean,
          label: "Do not show cached copy (noarchive)",
          wrapper_html: { class: "true_false" }
        )
        text_node meta_ff.input(
          :robots_nosnippet,
          as: :boolean,
          label: "Do not show text snippets (nosnippet)",
          wrapper_html: { class: "true_false" }
        )
        text_node meta_ff.input(
          :block_ai_crawlers,
          as: :boolean,
          label: "Discourage AI training crawlers",
          hint: "Adds noai and noimageai to the robots meta tag where supported.",
          wrapper_html: { class: "true_false" }
        )
      end
    end
  end
end
